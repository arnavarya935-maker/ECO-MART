# Eco Sense Environment Variables
# Server-Side Variables (Never exposed to the client or committed to git)
# Plain note: After adding variables in Vercel you must redeploy.

# 1. Gemini API Key (Required for online Eco Agent, Vision Label Scanner, and Greenwashing Detective)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Routing (Default: gemini-3-flash-preview or gemini-1.5-flash)
GEMINI_MODEL=gemini-3-flash-preview
AGENT_MODEL=gemini-3-flash-preview

# 2. Supabase Configuration (Live Products Catalog & Contact Form Database)
# Create a free project at https://supabase.com/
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Web3Forms Public Key (Contact Us Form Email Delivery)
# Get a free access key in 30 seconds at https://web3forms.com/
VITE_WEB3FORMS_KEY=your_web3forms_key_here

# 4. Optional Port for standalone proxy server (default: 3001)
PORT=3001
