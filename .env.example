# EcoMart AI Environment Variables
# CBSE Competition Sub-theme: Ethics and Responsible Use of AI

# Gemini API Key (Backend Proxy only - never exposed to browser or committed)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Provider Configuration (default: gemini)
# Supported: gemini | mock
AI_PROVIDER=gemini

# Optional Port for standalone proxy server (default: 3001)
PORT=3001
