# EcoMart AI & News Environment Variables (Server-Side Only)

# Gemini API Key (Backend Proxy only - never exposed to browser or committed)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Routing (Default: stable gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Eco News Provider Configuration (Default: gnews, optional: newsdata)
# GNews Free Tier: 100 requests/day, 10 articles/req, ~12h delay, non-commercial use
NEWS_PROVIDER=gnews
NEWS_API_KEY=your_news_api_key_here

# Optional Port for standalone proxy server (default: 3001)
PORT=3001
